# .env.example  —  copy to .env for LOCAL testing only.
# On GitHub these are added as repository Secrets, NOT committed as a file.
#
#   cp .env.example .env     then fill in real values
#   (.env is git-ignored — never commit real keys)

# --- Telegram ---------------------------------------------------------------
# From @BotFather after you create a bot.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz

# From @userinfobot — your numeric chat ID.
TELEGRAM_CHAT_ID=123456789

# --- LLM (Google Gemini, free tier) -----------------------------------------
# From https://aistudio.google.com  ->  "Get API key"
LLM_API_KEY=your-gemini-api-key-here

# Optional — override the model. Defaults to gemini-2.5-flash if unset.
LLM_MODEL=gemini-2.5-flash
